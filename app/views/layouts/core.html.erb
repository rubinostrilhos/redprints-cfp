<!DOCTYPE html>
<html>
  <head>
    <title inertia><%= content_for(:title) || "Tropical on Rails CFP" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta name="description" content="Submit your talk to Tropical on Rails 2027, March 18-19 in São Paulo. Single track, 30-minute talks, 700+ Rails developers. CFP closes December 22, 2026.">

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://cfp.tropicalonrails.com">
    <meta property="og:title" content="Call for proposals: Tropical on Rails 2027">
    <meta property="og:description" content="Submit your talk to Tropical on Rails 2027, March 18-19 in São Paulo. Single track, 30-minute talks, 700+ Rails developers. CFP closes December 22, 2026.">
    <!-- Twitter -->
    <meta property="twitter:card" content="summary">
    <meta property="twitter:url" content="https://cfp.tropicalonrails.com">
    <meta property="twitter:title" content="Call for proposals: Tropical on Rails 2027">
    <meta property="twitter:description" content="Submit your talk to Tropical on Rails 2027, March 18-19 in São Paulo. Single track, 30-minute talks, 700+ Rails developers. CFP closes December 22, 2026.">
    <!-- End of Open Graph / Social Media -->

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= yield :head %>

    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application', media: 'all' %>
  </head>

  <body>
    <%= content_for?(:content) ? yield(:content) : yield %>
  </body>
</html>
